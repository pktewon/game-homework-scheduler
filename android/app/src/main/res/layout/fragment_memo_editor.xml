<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:background="#F4F6FA" android:fillViewport="true" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:id="@+id/editorRoot" android:padding="16dp" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/back" android:text="취소 · 돌아가기" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        <TextView android:id="@+id/heading" android:text="메모 등록·수정" android:textSize="24sp" android:textStyle="bold" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/gameName" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/title" android:hint="메모 제목 (1~100자)" android:inputType="textCapSentences" android:maxLength="100" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/body" android:hint="메모 내용 (1~10,000자)" android:inputType="textMultiLine" android:gravity="top" android:minLines="6" android:maxLength="10000" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="연결할 이벤트 (선택)" android:textStyle="bold" android:paddingTop="12dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/eventChoice" android:text="이벤트 연결 없음 · 게임 메모" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/clearEvent" android:text="이벤트 연결 해제" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:text="같은 게임의 이벤트에만 연결할 수 있습니다. 연결하지 않으면 게임 메모로 저장합니다. 메모 수정은 이벤트 기간이나 완료 체크를 바꾸지 않습니다." android:layout_width="match_parent" android:layout_height="wrap_content" />
        <TextView android:id="@+id/status" android:textColor="#9E2929" android:accessibilityLiveRegion="polite" android:paddingTop="8dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <Button android:id="@+id/save" android:text="메모 저장" android:layout_width="match_parent" android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
