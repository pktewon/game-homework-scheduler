<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="#F4F6FA">
    <LinearLayout android:id="@+id/editorRoot" android:orientation="vertical" android:padding="16dp" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/back" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="취소 · 돌아가기" />
        <TextView android:id="@+id/heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="이벤트 등록 · 수정" android:textSize="24sp" android:textStyle="bold" />
        <TextView android:id="@+id/gameName" android:layout_width="match_parent" android:layout_height="wrap_content" />
        <EditText android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="이벤트 이름" android:inputType="textCapSentences" android:maxLength="100" />
        <EditText android:id="@+id/notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="메모 (선택)" android:inputType="textMultiLine" android:maxLength="1000" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="날짜와 시각은 모두 한국 시각(UTC+9)입니다. 모르는 시각은 미정으로 남길 수 있습니다." />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="참여 기간" android:textStyle="bold" android:textSize="20sp" android:paddingTop="12dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/playStart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="참여 시작 설정" />
            <Button android:id="@+id/clearPlayStart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="미정" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/playEnd" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="참여 종료 설정" />
            <Button android:id="@+id/clearPlayEnd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="미정" />
        </LinearLayout>
        <CheckBox android:id="@+id/includeShop" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="별도의 보상 교환 기간 사용" android:minHeight="48dp" />
        <LinearLayout android:id="@+id/shopFields" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="보상 교환 기간" android:textStyle="bold" android:textSize="20sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/shopStart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="교환 시작 설정" />
                <Button android:id="@+id/clearShopStart" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="미정" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <Button android:id="@+id/shopEnd" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="교환 종료 설정" />
                <Button android:id="@+id/clearShopEnd" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="미정" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="수정해도 완료 기록 유지" android:id="@+id/preservationNote" android:paddingTop="8dp" />
        <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#9E2929" android:accessibilityLiveRegion="polite" />
        <Button android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="이벤트 저장" />
    </LinearLayout>
</ScrollView>
