<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/homeRoot" android:orientation="vertical" android:background="#F4F6FA"
    android:padding="16dp" android:layout_width="match_parent" android:layout_height="match_parent">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="나의 게임 일정" android:textSize="26sp" android:textStyle="bold" android:textColor="#18243B" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="공식 일정과 내가 등록한 이벤트\n완료는 내가 체크" android:paddingTop="6dp" />
    <Button android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="공식 일정 새로고침" />
    <Button android:id="@+id/dailyTasks" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="일일 숙제 · 초기화 설정 · 완료 기록" />
    <Button android:id="@+id/manageGames" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="내 게임 · 이벤트와 숙제 등록" />
    <Button android:id="@+id/deadlineSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="참여·교환 마감 알림 설정" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:accessibilityLiveRegion="polite" android:paddingBottom="8dp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/events" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" />
</LinearLayout>
