<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:background="#FFFFFF" android:padding="14dp"
    android:layout_marginBottom="10dp" android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:id="@+id/eventTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textColor="#18243B" />
    <TextView android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="6dp" />
    <CheckBox android:id="@+id/check" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" />
</LinearLayout>
