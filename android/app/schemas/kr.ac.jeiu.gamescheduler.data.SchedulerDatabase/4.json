      {
        "viewName": "CheckRow",
        "createSql": "CREATE VIEW `${VIEW_NAME}` AS SELECT t.eventKey, t.sourceItemKey, t.title, t.sortOrder, t.missingFromLatest,\n    COALESCE(r.isDone, 0) AS isDone, r.completedAt FROM check_templates t\n    LEFT JOIN check_records r ON t.eventKey = r.eventKey AND t.sourceItemKey = r.sourceItemKey"
      }
