<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical"
    android:layout_width="match_parent" android:layout_height="wrap_content">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="나의 게임 일정"
        android:textSize="26sp" android:textStyle="bold" android:textColor="#18243B" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="놓치기 쉬운 마감부터, 완료는 내가 체크" />
    <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
        <Button android:id="@+id/manageGames" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="내 게임 · 등록" />
        <Button android:id="@+id/deadlineSettings" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="마감 알림 설정" />
    </LinearLayout>
    <TextView android:id="@+id/imminentHeading" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="12dp"
        android:textSize="20sp" android:textStyle="bold" android:textColor="#A13920" />
    <LinearLayout android:id="@+id/imminentItems" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="오늘의 숙제" android:paddingTop="12dp"
        android:textSize="20sp" android:textStyle="bold" android:textColor="#18243B" />
    <TextView android:id="@+id/dailySummary" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <LinearLayout android:id="@+id/dailyGames" android:orientation="vertical" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/refresh" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="공식 일정 새로고침" />
    <TextView android:id="@+id/status" android:layout_width="match_parent" android:layout_height="wrap_content" android:accessibilityLiveRegion="polite" android:textSize="12sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="이벤트 모아보기" android:paddingTop="12dp" android:textSize="20sp" android:textStyle="bold" android:textColor="#18243B" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false">
        <LinearLayout android:id="@+id/filters" android:orientation="horizontal" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    </HorizontalScrollView>
    <TextView android:id="@+id/filterInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="10dp" android:accessibilityLiveRegion="polite" />
</LinearLayout>
